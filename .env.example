# En la carpeta del proyecto, crea tu copia privada una sola vez con PowerShell:
# if (!(Test-Path -LiteralPath .env)) { Copy-Item .env.example .env }
# notepad .env
# Guarda en UTF-8 y reinicia el bot para aplicar cambios.
# Dentro de .env usa valores literales. Escribe los comentarios en líneas separadas.

# Si el mismo proveedor te dio una sola clave para ambas rutas, introdúcela aquí.
# Si te dio dos, deja esta opción vacía y completa las claves individuales de abajo.
MODEL_API_KEY=

# Si tu servidor usa una autoridad certificadora privada, indica la ruta
# absoluta a su certificado de confianza en formato PEM. Para HTTPS con
# certificados de confianza del sistema, deja esta opción vacía.
MODEL_CA_FILE=

# Supervisor remoto. Pega la URL HTTPS completa del endpoint de chat completions
# de tu proveedor, por ejemplo https://tu-servidor.example/v1/chat/completions.
# Deja SUPERVISOR_MODEL vacío para descubrir el primer modelo en /v1/models
# o escribe el identificador exacto para seleccionar uno en particular.
SUPERVISOR_API_URL=
SUPERVISOR_MODEL=
SUPERVISOR_API_KEY=

# Laya remoto. Usa workspace para tu endpoint de agente, por ejemplo
# https://tu-servidor.example/api/v1/laya/agent.
# En instalaciones que usan la ruta nativa /v1/systemone, elige systemone.
# Para chat completions elige chat y completa LAYA_MODEL.
LAYA_API_FORMAT=workspace
LAYA_API_URL=
LAYA_MODEL=
LAYA_API_KEY=

# Polymarket: el simulador lee mercados y precios públicos. Sus conexiones
# actuales funcionan sin credenciales de Polymarket ni claves de billetera.
